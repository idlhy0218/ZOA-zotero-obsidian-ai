# Paper Summarizer — Configuration Template
# Copy this file to ".env" and fill in your values.
# Do NOT commit .env to version control.

# [Required] Google Gemini API key
# Get yours free at: https://aistudio.google.com/app/apikey
GEMINI_KEY=

# [Required] Obsidian output folder
# The folder inside your Obsidian vault where summaries will be saved
OBS_PATH=

# [Optional] Zotero local DB path
# Leave blank to use the default: C:\Users\YourName\Zotero\zotero.sqlite
ZOTERO_DB=

# [Optional] Zotero PDF storage folder
# Only needed for full-text summarization (instead of abstract-only)
PDF_PATH=
